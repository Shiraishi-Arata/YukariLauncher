<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="android:scrollbarThumbHorizontal">@color/favorite_color</item>
        <item name="android:scrollbarThumbVertical">@color/favorite_color</item>

        <item name="colorPrimary">@color/settings_category</item>
        <item name="colorOnPrimary">@color/black_or_white</item>
        <item name="colorPrimaryContainer">@color/background_menu_element</item>
        <item name="colorOnPrimaryContainer">@color/primary_text</item>
        <item name="colorSecondary">@color/favorite_color</item>
        <item name="colorSecondaryContainer">@color/background_item_selected</item>
        <item name="colorTertiary">@color/favorite_color</item>
        <item name="colorSurface">@color/background_app</item>
        <item name="colorSurfaceContainer">@color/background_item</item>
        <item name="colorSurfaceContainerHigh">@color/background_overlay</item>
        <item name="colorOnSurface">@color/primary_text</item>
        <item name="colorOutline">@color/background_menu_element</item>

        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">@dimen/_12ssp</item>

        <item name="buttonStyle">@style/Yukari.MaterialButton</item>
        <item name="materialButtonStyle">@style/Yukari.MaterialButton</item>
        <item name="materialCardViewStyle">@style/Yukari.MaterialCardView</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.FilledBox</item>
        <item name="alertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="shapeAppearanceMediumComponent">@style/Yukari.Shape.Medium</item>
        <item name="shapeAppearanceSmallComponent">@style/Yukari.Shape.Small</item>
        <item name="switchStyle">@style/Yukari.MaterialSwitch</item>
        <item name="materialSwitchStyle">@style/Yukari.MaterialSwitch</item>
    </style>


    <style name="Yukari.MaterialButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/button_background_selected</item>
        <item name="android:textColor">@color/black_or_white</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Yukari.MaterialButton.Flat" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>

    <style name="Yukari.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="useMaterialThemeColors">false</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="thumbTint">?attr/colorPrimary</item>
    </style>

    <style name="Yukari.MaterialCardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/background_item</item>
        <item name="strokeColor">@color/background_menu_element</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/Yukari.Shape.Medium</item>
    </style>
    
    <style name="Yukari.MaterialButton.Outlined" parent="Yukari.MaterialButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/purple</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Yukari.MaterialCheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <style name="Yukari.Shape.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Yukari.Shape.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="CustomDialogStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:scrollbarThumbHorizontal">@color/favorite_color</item>
        <item name="android:scrollbarThumbVertical">@color/favorite_color</item>
        <item name="colorPrimary">@color/settings_category</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Material3.BodyMedium</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:scrollbarThumbHorizontal">@color/favorite_color</item>
        <item name="android:scrollbarThumbVertical">@color/favorite_color</item>
        <item name="colorPrimary">@color/settings_category</item>
    </style>

    <style name="RoundedCornersImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4%</item>
    </style>

    <style name="RoundImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
