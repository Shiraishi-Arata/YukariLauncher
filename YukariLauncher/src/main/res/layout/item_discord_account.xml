<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/_4sdp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Banner -->
        <ImageView
            android:id="@+id/profile_banner"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            android:background="@drawable/discord_profile_banner"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Avatar with border -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatar_wrapper"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/_12sdp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="@id/profile_banner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_banner"
            app:layout_constraintVertical_bias="0.0">

            <ImageView
                android:id="@+id/account_avatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_discord" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Display Name -->
        <TextView
            android:id="@+id/account_display_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@+id/discord_badge"
            app:layout_constraintStart_toEndOf="@id/avatar_wrapper"
            app:layout_constraintTop_toBottomOf="@id/profile_banner"
            tools:text="Arata" />

        <!-- Discord Badge -->
        <ImageView
            android:id="@+id/discord_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:contentDescription="Discord"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_discord"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_banner" />

        <!-- Username + Discriminator + Status -->
        <TextView
            android:id="@+id/account_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/avatar_wrapper"
            app:layout_constraintTop_toBottomOf="@id/account_display_name"
            tools:text="arata#1234 • Playing Minecraft" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
